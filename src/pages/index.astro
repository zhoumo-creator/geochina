---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import DitherIsland from '../components/DitherIsland.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter(post => !post.id.endsWith('-en'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero: Large Typography + Dither Canvas -->
		<section class="hero">
			<div class="hero-text">
				<div class="section-label hero-label"><span class="label-dot"></span> AI-DRIVEN GROWTH AGENT</div>
				<h1>
					你定方向，<br/>Agent 干活。
				</h1>
				<p class="hero-subhead">
					中文 B2B 团队的 GEO Agent。覆盖中西方 9 大 AI 引擎，每周交付可合并 PR —— 你点 Merge，排名自己动。
				</p>
				<div class="hero-ctas">
					<a href="/scan" class="btn-cta">
						免费扫我的 AI 可见性
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
					</a>
					<a href="/skills" class="btn-outline-dark">
						看开源 Skills
					</a>
				</div>
			</div>
			<div class="hero-canvas">
				<DitherIsland client:load />
			</div>
		</section>

		<!-- Engines Strip (Dark Band) -->
		<section class="engines-strip">
			<div class="engines-inner">
				<p class="engines-title">覆盖中西方 9 大 AI 引擎</p>
				<div class="engines-track">
					<span class="engine-tag cn">豆包</span>
					<span class="engine-tag cn">Kimi</span>
					<span class="engine-tag cn">元宝</span>
					<span class="engine-tag cn">文心</span>
					<span class="engine-tag cn">通义</span>
					<span class="engines-divider"></span>
					<span class="engine-tag west">ChatGPT</span>
					<span class="engine-tag west">Perplexity</span>
					<span class="engine-tag west">Claude</span>
					<span class="engine-tag west">Google AIO</span>
				</div>
			</div>
		</section>

		<!-- Stats Strip -->
		<section class="stats-strip">
			<div class="stats-inner">
				<div class="stat-item">
					<span class="stat-value">33 <small>×</small></span>
					<span class="stat-desc">Rootly 实施 GEO 策略后的 AI 引用率增长倍数</span>
					<span class="stat-src">来源：Rootly 2025 案例公开数据</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">78.72 <small>%</small></span>
					<span class="stat-desc">GEO 优化后内容被 AI 摘要引用的概率</span>
					<span class="stat-src">来源：Princeton KDD 2024 论文</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">100 <small>M</small></span>
					<span class="stat-desc">每周通过 AI 搜索引擎获取信息的中文用户数量</span>
					<span class="stat-src">来源：QuestMobile 2025 估算</span>
				</div>
			</div>
			<div class="scroll-hint">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
				SCROLL DOWN
			</div>
		</section>

		<!-- Mission -->
		<section class="mission-section">
			<p class="mission-text">目标是成为业内最好用的 GEO Agent。</p>
		</section>

		<!-- Technology Section -->
		<main>
			<section class="pillars-section">
				<div class="section-label"><span class="label-dot"></span> 三个入口，一条路径</div>
				<h2 class="pillars-title">先体验，再上手，最后交给我们</h2>
				<div class="pillars-grid">
					<a href="/scan" class="pillar-card">
						<span class="pillar-num">01 · 免费工具</span>
						<h3>在线 GEO 扫描</h3>
						<p>输入网址，60 秒拿到中文引擎 + 海外引擎双轨就绪度报告：爬虫可达性、SSR、结构化数据、可引用性，附最该先做的优化清单。</p>
						<span class="pillar-link">免费扫描 →</span>
					</a>
					<a href="/skills" class="pillar-card">
						<span class="pillar-num">02 · 开源 Skills</span>
						<h3>GEO Skills 精选 + 自研</h3>
						<p>市面上的开源 GEO skills 我们逐个精读拆解、只留能出活的；「中文 5 引擎监控」这个开源空白，我们自己在补，陆续开源。</p>
						<span class="pillar-link">看 Skills →</span>
					</a>
					<a href="/services" class="pillar-card">
						<span class="pillar-num">03 · 订阅服务</span>
						<h3>每周交付的 GEO Agent</h3>
						<p>不想自己动手？订阅后每周直接收到：5 大中文引擎可见度看板、竞品动态、可发布内容和可合并修改——你点 Merge 就行。</p>
						<span class="pillar-link">了解服务 →</span>
					</a>
				</div>
			</section>

			<!-- What is GEO -->
			<section class="what-section">
				<div class="what-grid">
					<div class="what-left">
						<div class="section-label"><span class="label-dot"></span> 概念</div>
						<h2>SEO 优化排名。<br/>GEO 优化引用。</h2>
					</div>
					<div class="what-right">
						<p>
							传统 SEO 的目标是让你出现在 Google 搜索结果的第一页。
							GEO 的目标是让 AI——ChatGPT、Perplexity、Google AI Overview——在回答用户问题时，主动引用你的内容作为信息来源。
						</p>
						<p>
							根据 Princeton 大学的研究，结构化的 GEO 策略可以将内容在 AI 生成回答中的可见度提升高达 <strong>40%</strong>。
							而来自 AI 引荐的流量，其转化率通常是传统搜索流量的 <strong>5 倍</strong>。
						</p>
					</div>
				</div>
			</section>

			<!-- Comparison Table -->
			<section class="compare-section">
				<div class="section-label"><span class="label-dot"></span> 对比</div>
				<h2>GeoChina Agent vs 传统 SEO 工具</h2>
				<p class="compare-lead">传统工具停在「告诉你该做什么」。GEO Agent 直接「帮你做完」。</p>
				<div class="compare-wrap">
					<table class="compare-table">
						<thead>
							<tr>
								<th></th>
								<th class="col-us">GeoChina Agent</th>
								<th>Ahrefs / SEMrush</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>交付物</td>
								<td class="col-us">可合并 PR（代码级）</td>
								<td>PDF / 仪表盘报告</td>
							</tr>
							<tr>
								<td>执行方</td>
								<td class="col-us">Agent 自动执行</td>
								<td>需人工操作 5+ 步</td>
							</tr>
							<tr>
								<td>中国 AI 引擎</td>
								<td class="col-us">覆盖 5 大引擎</td>
								<td>不支持</td>
							</tr>
							<tr>
								<td>优化目标</td>
								<td class="col-us">AI 引用率（GEO）</td>
								<td>搜索排名（SEO）</td>
							</tr>
							<tr>
								<td>代码归属</td>
								<td class="col-us">100% 归客户</td>
								<td>N/A</td>
							</tr>
							<tr>
								<td>模式</td>
								<td class="col-us">问卷 + Agent 即服务</td>
								<td>自助 SaaS 月费</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- Blog -->
			<section class="blog-section">
				<h2>最新文章</h2>
				<div class="posts-list">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-row">
							<div class="post-info">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
								</time>
								<h3>{post.data.title}</h3>
							</div>
							<span class="post-arrow">→</span>
						</a>
					))}
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-section">
				<h2>先从一次免费扫描开始</h2>
				<p>60 秒看到你的网站在中文 AI 引擎眼里什么样。</p>
				<div class="cta-buttons">
					<a href="/scan" class="btn-cta">
						免费扫描我的网站
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
					</a>
					<a href="mailto:hi@geochina.co" class="btn-outline">
						联系我们
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
					</a>
				</div>
			</section>

		</main>
		<Footer />

		<!-- Mount Dither React Island -->

	</body>
</html>

<style>
	/* ==================== HOMEPAGE WIDE LAYOUT ==================== */
	main {
		width: var(--max-w-wide);
		max-width: calc(100% - 3em);
	}

	/* ==================== HERO ==================== */
	.hero {
		max-width: var(--max-w-wide);
		margin: 0 auto;
		padding: 6em 1.5em 2em;
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 4em;
		align-items: center;
	}
	.hero h1 {
		font-size: 4.4em;
		line-height: 1.08;
		letter-spacing: -0.035em;
		margin-bottom: 0.5em;
	}
	.hero-label {
		margin-bottom: 1.5em;
	}
	.hero-label .label-dot {
		background: var(--accent);
	}
	.hero-subhead {
		font-size: 1.1em;
		color: var(--text-secondary);
		margin-top: 0;
		margin-bottom: 1.8em;
		line-height: 1.7;
		max-width: 460px;
	}
	.hero-ctas {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 1.6em;
	}
	.btn-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		background: var(--cta);
		color: white;
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		transition: all 0.2s;
	}
	.btn-cta:hover {
		background: var(--cta-hover);
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(217, 75, 59, 0.3);
		color: white;
	}
	.btn-outline-dark {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 24px;
		background: transparent;
		color: var(--black);
		border: 1.5px solid var(--black);
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		transition: all 0.2s;
	}
	.btn-outline-dark:hover {
		background: var(--black);
		color: white;
	}
	.btn-dark {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		background: var(--black);
		color: white;
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		transition: all 0.2s;
	}
	.btn-dark:hover {
		background: #333;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(0,0,0,0.15);
		color: white;
	}
	.trust-band {
		display: flex;
		gap: 1.6em;
		list-style: none;
		padding: 0;
		margin: 0;
		flex-wrap: wrap;
	}
	.trust-band li {
		font-size: 13px;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 5px;
	}
	.trust-check {
		color: var(--accent);
		font-weight: 700;
	}
	.hero-canvas {
		width: 100%;
		height: 480px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: #f0f0ec;
	}
	.hero-subhead {
		max-width: 520px;
	}

	/* ==================== ENGINES STRIP ==================== */
	.engines-strip {
		background: var(--accent-deep);
		padding: 1.4em 0;
		overflow: hidden;
	}
	.engines-inner {
		max-width: var(--max-w-wide);
		margin: 0 auto;
		padding: 0 1.5em;
		display: flex;
		align-items: center;
		gap: 2.5em;
	}
	.engines-title {
		font-size: 11px;
		color: rgba(255,255,255,0.55);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
		margin: 0;
	}
	.engines-track {
		display: flex;
		align-items: center;
		gap: 1.8em;
		flex: 1;
		flex-wrap: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.engines-track::-webkit-scrollbar { display: none; }
	.engine-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 14px;
		font-weight: 500;
		white-space: nowrap;
	}
	.engine-tag.cn { color: var(--gold); }
	.engine-tag.west { color: rgba(255,255,255,0.85); }
	.engines-divider {
		height: 16px;
		width: 1px;
		background: rgba(255,255,255,0.25);
		flex-shrink: 0;
	}

	/* ==================== STATS ==================== */
	.stats-strip {
		max-width: var(--max-w-wide);
		margin: 0 auto;
		padding: 4em 1.5em 3em;
		border-bottom: 1px solid var(--border);
		position: relative;
	}
	.stats-inner {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 3em;
	}
	.stat-value {
		display: block;
		font-family: var(--font-serif);
		font-size: 3.5em;
		font-weight: 400;
		color: var(--black);
		letter-spacing: -0.02em;
		line-height: 1;
		margin-bottom: 16px;
	}
	.stat-value small {
		font-size: 0.5em;
		color: var(--text-muted);
		font-weight: 400;
	}
	.stat-desc {
		display: block;
		font-size: 14px;
		color: var(--text-secondary);
		line-height: 1.6;
	}
	.stat-src {
		display: block;
		font-size: 11px;
		color: var(--text-muted);
		margin-top: 4px;
	}
	.scroll-hint {
		position: absolute;
		bottom: 2em;
		left: 1.5em;
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--text-muted);
	}

	/* ==================== PILLARS ==================== */
	.pillars-section {
		padding: 4em 0 3em;
		border-bottom: 1px solid var(--border);
	}
	.pillars-title {
		font-size: 2em;
		margin: 0.5em 0 1.2em;
	}
	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.4em;
	}
	.pillar-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-section);
		border-radius: var(--radius-lg);
		padding: 1.8em;
		text-decoration: none;
		color: var(--text);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.pillar-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
	}
	.pillar-num {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1em;
	}
	.pillar-card h3 {
		font-family: 'Inter', 'Noto Sans SC', sans-serif;
		font-size: 1.15em;
		font-weight: 700;
		margin-bottom: 0.6em;
	}
	.pillar-card p {
		font-size: 14px;
		color: var(--text-secondary);
		line-height: 1.75;
		flex: 1;
		margin-bottom: 1.2em;
	}
	.pillar-link {
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
	}
	.section-label {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 2em;
	}
	.label-dot {
		width: 6px;
		height: 6px;
		background: var(--black);
		display: inline-block;
	}
	/* ==================== WHAT ==================== */
	.what-section {
		padding: 4em 0;
		border-bottom: 1px solid var(--border);
	}
	.what-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4em;
	}
	.what-left h2 {
		font-size: 2.2em;
		margin-top: 0.5em;
	}
	.what-right p {
		font-size: 16px;
		color: var(--text-secondary);
		line-height: 1.85;
	}
	.what-right strong {
		color: var(--black);
	}

	/* ==================== BLOG ==================== */
	.blog-section {
		padding: 4em 0 2em;
	}
	.blog-section h2 {
		margin-bottom: 1em;
	}
	.post-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5em 0;
		border-top: 1px solid var(--border-light);
		text-decoration: none;
		transition: padding-left 0.2s;
	}
	.post-row:last-child {
		border-bottom: 1px solid var(--border-light);
	}
	.post-row:hover {
		padding-left: 12px;
	}
	.post-info time {
		font-size: 13px;
		color: var(--text-muted);
		display: block;
		margin-bottom: 4px;
	}
	.post-info h3 {
		font-family: 'Inter', 'Noto Sans SC', sans-serif;
		font-size: 1.05em;
		font-weight: 700;
		color: var(--black);
		transition: color 0.15s;
	}
	.post-row:hover h3 {
		color: var(--accent);
	}
	.post-arrow {
		font-size: 1.3em;
		color: var(--text-muted);
		transition: transform 0.15s;
	}
	.post-row:hover .post-arrow {
		transform: translateX(4px);
		color: var(--black);
	}

	/* ==================== CTA ==================== */
	.cta-section {
		text-align: center;
		padding: 5em 2em;
		margin: 2em 0;
		background: var(--bg-section);
		border-radius: var(--radius-lg);
	}
	.cta-section h2 {
		margin-bottom: 0.4em;
		font-size: 2em;
	}
	.cta-section p {
		margin-bottom: 1.5em;
		font-size: 16px;
	}
	.cta-buttons {
		display: flex;
		gap: 12px;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}
	.btn-outline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		background: transparent;
		color: var(--black);
		border: 1.5px solid var(--black);
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		transition: all 0.2s;
	}
	.btn-outline:hover {
		background: var(--black);
		color: white;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(0,0,0,0.15);
	}

	/* ==================== MISSION ==================== */
	.mission-section { max-width: var(--max-w-wide); margin: 0 auto; padding: 3em 1.5em; border-bottom: 1px solid var(--border); text-align: center; }
	.mission-text { font-family: var(--font-serif); font-size: 1.4em; color: var(--text-secondary); font-weight: 400; margin: 0; letter-spacing: -0.01em; }

	/* ==================== COMPARE TABLE ==================== */
	.compare-section {
		padding: 4em 0;
		border-bottom: 1px solid var(--border);
	}
	.compare-section h2 {
		margin-top: 0.5em;
		margin-bottom: 0.3em;
