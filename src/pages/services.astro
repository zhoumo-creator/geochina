---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title="服务 — GEO China"
			description="GEO China 三大服务:SEO/GEO Agent · 增长整合营销 · 定制审计与咨询。中文 B2B 团队的 AI 增长伙伴。"
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<div class="section-label"><span class="label-dot"></span> Services</div>
				<h1>三条线,一起干。</h1>
				<p class="page-desc">
					一条产品线让 Agent 自动 ship PR;一条服务线由 provider 网络执行海内外整合营销;还有按需的单次咨询。
				</p>
			</section>

			<section class="services-row">
				<div class="svc-card">
					<span class="svc-tag tag-cta">产品 · SaaS</span>
					<h2>SEO / GEO Agent</h2>
					<p class="svc-desc">
						覆盖中西方 9 大 AI 引擎,每周自动产出可合并 PR。代码归你,30 天退款,随时停服。
					</p>
					<p class="svc-meta">¥199 / ¥1499 月付 · 中英双语</p>
				</div>

				<div class="svc-card">
					<span class="svc-tag tag-gold">服务 · Provider 网络</span>
					<h2>增长整合营销</h2>
					<p class="svc-desc">
						我们策略统筹,严选 provider 执行 —— 跨 Reddit / X / 小红书 / 知乎 / B站 / 公众号,以及线下 hacker house。
					</p>
					<p class="svc-meta">¥15k+/月 起 · 海外 $2.5k+/月起</p>
				</div>

				<div class="svc-card">
					<span class="svc-tag tag-blue">咨询 · 单次</span>
					<h2>定制审计与咨询</h2>
					<p class="svc-desc">
						GEO 技术审计、5 层竞品反向工程、出海/入华品牌策略路线图 —— 不订阅,要单次深度交付的找我们。
					</p>
					<p class="svc-meta">¥3,000 起</p>
				</div>
			</section>

			<!-- Contact -->
			<section class="contact-section">
				<div class="section-label"><span class="label-dot"></span> Contact</div>
				<h2 class="contact-title">聊聊你想做什么</h2>
				<p class="contact-lead">先听需求再给方案,不合适也直说。复制下方模板,选个你顺手的渠道发过来,2 个工作日内回复。</p>

				<div class="contact-card">
					<div class="template-head">
						<span class="template-label">📋 咨询模板</span>
						<button class="copy-btn" type="button" onclick="navigator.clipboard.writeText(document.getElementById('email-template').innerText); this.textContent='已复制 ✓'; setTimeout(()=>this.textContent='一键复制',2000);">一键复制</button>
					</div>
					<div id="email-template" class="template-body">我对以下服务感兴趣（可多选）：
☐ SEO/GEO Agent（产品）
☐ 增长整合营销（provider 服务）
☐ 定制审计与咨询

公司 / 网站：
当前主要问题：
3 个月内期望成果：
预算范围：
联系方式：</div>
				</div>

				<div class="contact-methods">
					<a href="mailto:hi@geochina.co" class="cm-card">
						<span class="cm-icon">✉</span>
						<span class="cm-label">Email</span>
						<span class="cm-value">hi@geochina.co</span>
					</a>
					<a href="https://t.me/zhoumo_828" target="_blank" rel="noopener" class="cm-card">
						<span class="cm-icon">✈</span>
						<span class="cm-label">Telegram</span>
						<span class="cm-value">@zhoumo_828</span>
					</a>
					<div class="cm-card">
						<span class="cm-icon">💬</span>
						<span class="cm-label">微信</span>
						<span class="cm-value">Moumlbius</span>
					</div>
				</div>

				<p class="contact-foot">
					还没确定要不要聊?先 <a href="/scan">免费扫一份 9 引擎可见性报告 →</a>
				</p>
			</section>

			<p class="page-updated">最后更新：2026 年 5 月</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--max-w-wide);
		max-width: calc(100% - 3em);
	}
	.page-header { padding: 5em 0 3em; }
	.page-header h1 {
		margin-top: 0.6em;
		margin-bottom: 0.5em;
		font-size: 3.6em;
		line-height: 1.12;
	}
	.page-desc {
		font-size: 1.15em;
		color: var(--text-secondary);
		max-width: 680px;
		line-height: 1.7;
	}

	/* Services row */
	.services-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
		padding: 2em 0 4em;
	}
	.svc-card {
		padding: 2.2em 1.8em;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg);
		transition: all 0.2s;
	}
	.svc-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(26, 122, 76, 0.08);
	}
	.svc-tag {
		display: inline-block;
		font-size: 11px;
		font-weight: 700;
		padding: 4px 10px;
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 1.2em;
	}
	.svc-tag.tag-cta { background: rgba(217, 75, 59, 0.12); color: var(--cta-hover); }
	.svc-tag.tag-gold { background: rgba(232, 168, 56, 0.18); color: #8a5a0a; }
	.svc-tag.tag-blue { background: #eff6ff; color: var(--blue); }
	.svc-card h2 {
		font-size: 1.5em;
		margin-bottom: 0.6em;
	}
	.svc-desc {
		font-size: 15px;
		line-height: 1.75;
		color: var(--text-secondary);
		margin-bottom: 1.2em;
	}
	.svc-meta {
		font-size: 13px;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
		margin: 0;
	}

	/* Contact */
	.contact-section {
		padding: 4em 0 5em;
		border-top: 1px solid var(--border);
	}
	.contact-title {
		margin-top: 0.6em;
		margin-bottom: 0.5em;
		font-size: 2.4em;
	}
	.contact-lead {
		font-size: 1.05em;
		line-height: 1.75;
		max-width: 680px;
		margin-bottom: 2em;
	}

	.contact-card {
		background: var(--bg-section);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		margin-bottom: 1.5em;
	}
	.template-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.9em 1.4em;
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	.template-label {
		font-size: 13px;
		font-weight: 700;
		color: var(--black);
	}
	.copy-btn {
		font-size: 12px;
		font-weight: 600;
		padding: 7px 14px;
		background: var(--accent);
		color: white;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		font-family: inherit;
		transition: background 0.2s;
	}
	.copy-btn:hover { background: var(--accent-hover); }
	.template-body {
		font-family: 'JetBrains Mono', monospace;
		font-size: 14px;
		line-height: 2;
		color: var(--text);
		padding: 1.5em 1.6em;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.contact-methods {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.9em;
		margin-bottom: 1.6em;
	}
	.cm-card {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
		padding: 1.2em 1.3em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		text-decoration: none;
		color: var(--text);
		transition: all 0.2s;
	}
	a.cm-card:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(26, 122, 76, 0.08);
	}
	.cm-icon {
		font-size: 18px;
		color: var(--accent);
		margin-bottom: 0.2em;
	}
	.cm-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
		font-weight: 700;
	}
	.cm-value {
		font-family: 'JetBrains Mono', monospace;
		font-size: 15px;
		font-weight: 500;
		color: var(--black);
	}

	.contact-foot {
		font-size: 14px;
		color: var(--text-muted);
		margin: 0;
	}
	.contact-foot a {
		color: var(--accent);
		font-weight: 600;
	}

	.page-updated { text-align: center; font-size: 12px; color: var(--text-muted); padding: 2em 0 0; margin: 0; }

	@media (max-width: 960px) {
		.services-row { grid-template-columns: 1fr; }
		.contact-methods { grid-template-columns: 1fr; }
	}
	@media (max-width: 720px) {
		.page-header h1 { font-size: 2.2em; }
		.contact-title { font-size: 1.8em; }
	}
</style>
