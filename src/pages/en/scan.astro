---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Free Chinese GEO Scan — Do Chinese AI engines recommend your site? | GEO China"
			description="Enter your website and get a 60-second dual-track AI readiness report: Chinese AI engines (Doubao/Kimi/Yuanbao/ERNIE/Qwen) + global AI engines — crawler reachability, SSR, structured data, citability score and a prioritized fix list."
		/>
	</head>
	<body>
		<Header lang="en" altHref="/scan" />

		<main>
			<section class="scan-hero">
				<div class="section-label"><span class="label-dot"></span> Free Tool</div>
				<h1>Do Chinese AI engines recommend your site?</h1>
				<p class="lead">
					Doubao, Kimi, Yuanbao, ERNIE and Qwen are making recommendations to your customers right now. Enter a URL and see your AI-engine readiness in 60 seconds — dual-track scoring for Chinese and global engines, plus the fixes to make first.
				</p>

				<div class="scan-box">
					<form id="scan-form" class="scan-form">
						<input
							id="scan-url"
							type="text"
							placeholder="Enter your website, e.g. example.com"
							autocomplete="url"
							required
						/>
						<button type="submit" class="btn-primary" id="scan-btn">Scan for free</button>
					</form>
					<p class="scan-hint" id="scan-status"></p>
				</div>

				<ul class="trust-band">
					<li><span class="trust-check">✓</span> Free</li>
					<li><span class="trust-check">✓</span> No sign-up</li>
					<li><span class="trust-check">✓</span> Results in 60s</li>
				</ul>
			</section>

			<section class="scan-result" id="result" hidden>
				<div class="score-panel">
					<div class="score-main">
						<div class="score-ring" id="score-ring"><span id="score-overall">0</span></div>
						<div class="score-caption">AI Engine Readiness</div>
					</div>
					<div class="score-tracks">
						<div class="track">
							<div class="track-head"><strong>Chinese engines</strong><span id="score-cn">0</span></div>
							<div class="bar"><div class="bar-fill cn" id="bar-cn"></div></div>
							<p class="track-note">Doubao · Kimi · Yuanbao · ERNIE · Qwen</p>
						</div>
						<div class="track">
							<div class="track-head"><strong>Global engines</strong><span id="score-global">0</span></div>
							<div class="bar"><div class="bar-fill gl" id="bar-global"></div></div>
							<p class="track-note">ChatGPT · Perplexity · Claude · Gemini</p>
						</div>
					</div>
					<button class="btn-secondary" id="download-btn">Download report</button>
				</div>

				<div class="result-grid">
					<div class="card">
						<h3>Chinese engine crawler reachability</h3>
						<table class="mini-table" id="table-cn"></table>
						<p class="card-note">Overseas-facing guides often say "block Bytespider" — but for the Chinese market you must allow it, or Doubao can't see you.</p>
					</div>
					<div class="card">
						<h3>Global engine crawler reachability</h3>
						<table class="mini-table" id="table-global"></table>
					</div>
					<div class="card">
						<h3>Infrastructure checks</h3>
						<ul class="check-list" id="check-list"></ul>
					</div>
					<div class="card">
						<h3>Citation-worthy elements</h3>
						<ul class="check-list" id="trigger-list"></ul>
						<p class="card-note">AI answers love quoting tables, numbers and step lists — the more of these you have, the more often you get "copied into" an answer.</p>
					</div>
				</div>

				<div class="card actions-card">
					<h3>Fixes to make first</h3>
					<ol class="action-list" id="action-list"></ol>
				</div>

				<div class="cta-block">
					<h3>Want to know how Doubao and Kimi actually answer questions in your industry?</h3>
					<p>
						The scan above is a site checkup. <strong>Real visibility</strong> — whether the 5 major Chinese engines recommend you, which competitor they name, whose content they cite — requires asking each engine real questions. We watch those shifts weekly for clients and ship the content and fixes directly.
					</p>
					<div class="cta-row">
						<a class="btn-primary" href="mailto:hi@geochina.co">Email us about your industry</a>
						<span class="cta-alt">or WeChat: Moumlbius</span>
					</div>
				</div>
			</section>
		</main>

		<Footer lang="en" />

		<script>
			const form = document.getElementById('scan-form');
			const statusEl = document.getElementById('scan-status');
			const btn = document.getElementById('scan-btn');
			const result = document.getElementById('result');
			let lastData = null;

			const STATUS_STEPS = [
				'Fetching your site…',
				'Checking AI crawler rules in robots.txt…',
				'Analyzing structured data and citability elements…',
				'Computing dual-track readiness…',
			];

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const url = document.getElementById('scan-url').value.trim();
				if (!url) return;

				btn.disabled = true;
				btn.textContent = 'Scanning…';
				result.hidden = true;
				let step = 0;
				statusEl.textContent = STATUS_STEPS[0];
				const ticker = setInterval(() => {
					step = Math.min(step + 1, STATUS_STEPS.length - 1);
					statusEl.textContent = STATUS_STEPS[step];
				}, 2500);

				try {
					const res = await fetch('/api/scan', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ url, lang: 'en' }),
					});
					const data = await res.json();
					clearInterval(ticker);
					if (!data.ok) {
						statusEl.textContent = data.error || 'Scan failed, please try again later';
						return;
					}
					statusEl.textContent = data.cached ? 'Done (scanned within 7 days — showing cached result)' : 'Scan complete';
					lastData = data;
					render(data);
				} catch {
					clearInterval(ticker);
					statusEl.textContent = 'Network error, please try again later';
				} finally {
					btn.disabled = false;
					btn.textContent = 'Scan for free';
				}
			});

			// One-click Markdown report download
			document.getElementById('download-btn').addEventListener('click', () => {
				if (!lastData) return;
				const md = buildReport(lastData);
				const host = new URL(lastData.url).hostname.replace(/\./g, '-');
				const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
				const a = document.createElement('a');
				a.href = URL.createObjectURL(blob);
				a.download = `geo-report-${host}-${lastData.scannedAt.slice(0, 10)}.md`;
				a.click();
				URL.revokeObjectURL(a.href);
			});

			function statusLabel(s) {
				return s === 'blocked' ? 'Blocked' : s === 'allowed' ? 'Explicitly allowed' : 'Allowed by default';
			}
			function statusDot(s) {
				const cls = s === 'blocked' ? 'dot-bad' : s === 'allowed' ? 'dot-good' : 'dot-ok';
				return `<span class="dot ${cls}"></span>${statusLabel(s)}`;
			}
			function checkDot(ok) {
				return `<span class="dot ${ok ? 'dot-good' : 'dot-bad'}"></span>`;
			}

			function buildChecks(ck) {
				return [
					[ck.ssr, "Server-side rendering (AI crawlers don't run JS)"],
					[ck.robotsTxt, 'robots.txt'],
					[ck.sitemap, `sitemap${ck.sitemapUrls ? ` (${ck.sitemapUrls} URLs)` : ''}`],
					[ck.llmsTxt, 'llms.txt'],
					[ck.schemaTypes.length > 0, `Structured data${ck.schemaTypes.length ? ': ' + ck.schemaTypes.slice(0, 3).join(', ') : ''}`],
					[ck.hasUpdateTimestamp, 'Visible update timestamp'],
				];
			}

			function buildReport(d) {
				const line = (c) => `| ${c.engine} | ${c.name} | ${statusLabel(c.status)} |`;
				const ck = d.checks;
				const checks = buildChecks(ck);
				return `# AI Engine Readiness Report: ${new URL(d.url).hostname}

> Scanned: ${d.scannedAt.slice(0, 10)} | Tool: geochina.co/en/scan (free)

## Overall score: ${d.scores.overall} / 100

| Track | Score |
|---|---|
| Chinese engines (Doubao · Kimi · Yuanbao · ERNIE · Qwen) | ${d.scores.china} |
| Global engines (ChatGPT · Perplexity · Claude · Gemini) | ${d.scores.global} |

## Chinese engine crawler reachability

| Engine | Crawler | Status |
|---|---|---|
${d.crawlers.cn.map(line).join('\n')}

## Global engine crawler reachability

| Engine | Crawler | Status |
|---|---|---|
${d.crawlers.global.map(line).join('\n')}

## Infrastructure checks

${checks.map(([ok, label]) => `- ${ok ? '✅' : '❌'} ${label}`).join('\n')}

## Citation-worthy elements

${ck.triggers.map((t) => `- ${t.found ? '✅' : '❌'} ${t.label}`).join('\n')}

## Fixes to make first

${d.actions.map((a, i) => `${i + 1}. **[${a.priority}] ${a.title}**\n   ${a.why}`).join('\n\n')}

---

Want to know how the 5 major Chinese AI engines answer questions in your industry — and who they recommend?
WeChat Moumlbius | hi@geochina.co | https://geochina.co
`;
			}

			function render(d) {
				document.getElementById('score-overall').textContent = d.scores.overall;
				document.getElementById('score-cn').textContent = d.scores.china;
				document.getElementById('score-global').textContent = d.scores.global;
				document.getElementById('bar-cn').style.width = d.scores.china + '%';
				document.getElementById('bar-global').style.width = d.scores.global + '%';

				const ring = document.getElementById('score-ring');
				ring.className = 'score-ring ' + (d.scores.overall >= 70 ? 'ring-good' : d.scores.overall >= 45 ? 'ring-mid' : 'ring-bad');

				const row = (c) =>
					`<tr><td><strong>${c.engine}</strong><span class="crawler-name">${c.name}</span></td><td class="td-status">${statusDot(c.status)}</td></tr>`;
				document.getElementById('table-cn').innerHTML = d.crawlers.cn.map(row).join('');
				document.getElementById('table-global').innerHTML = d.crawlers.global.map(row).join('');

				const checks = buildChecks(d.checks);
				document.getElementById('check-list').innerHTML = checks
					.map(([ok, label]) => `<li>${checkDot(ok)} ${label}</li>`)
					.join('');

				document.getElementById('trigger-list').innerHTML = d.checks.triggers
					.map((t) => `<li>${checkDot(t.found)} ${t.label}</li>`)
					.join('');

				document.getElementById('action-list').innerHTML = d.actions
					.map(
						(a) =>
							`<li><span class="pri pri-${a.priority}">${a.priority}</span><div><strong>${a.title}</strong><p>${a.why}</p></div></li>`
					)
					.join('');

				result.hidden = false;
				result.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		</script>
	</body>
</html>

<style>
	/* ─── Apple-flat: generous whitespace, soft gray cards, pill buttons ─── */
	.scan-hero {
		padding: 4.5em 0 3em;
	}
	.section-label {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1.5em;
	}
	.label-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		display: inline-block;
	}
	.scan-hero h1 {
		font-size: 2.8em;
		line-height: 1.15;
		letter-spacing: -0.02em;
		font-weight: 700;
		margin-bottom: 0.5em;
	}
	.lead {
		font-size: 1.12em;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 2.2em;
		max-width: 640px;
	}
	.scan-box {
		margin-bottom: 1.6em;
		max-width: 640px;
	}
	.scan-form {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	.scan-form input {
		flex: 1;
		min-width: 240px;
		padding: 15px 20px;
		font-size: 16px;
		border: none;
		border-radius: 14px;
		background: #f5f5f7;
		color: inherit;
		outline: none;
		transition: box-shadow 0.2s;
	}
	.scan-form input:focus {
		box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.25);
	}
	.scan-hint {
		margin: 0.9em 0 0;
		font-size: 13px;
		color: var(--text-muted);
		min-height: 1.2em;
	}
	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 15px 30px;
		background: #0071e3;
		color: #fff;
		border: none;
		cursor: pointer;
		border-radius: 980px;
		font-weight: 500;
		font-size: 15px;
		text-decoration: none;
		transition: background 0.2s;
	}
	.btn-primary:hover {
		background: #0077ed;
		color: #fff;
	}
	.btn-primary:disabled {
		opacity: 0.55;
		cursor: wait;
	}
	.btn-secondary {
		display: inline-flex;
		align-items: center;
		padding: 11px 24px;
		background: transparent;
		color: #0071e3;
		border: 1px solid #0071e3;
		cursor: pointer;
		border-radius: 980px;
		font-weight: 500;
		font-size: 14px;
		transition: background 0.2s;
	}
	.btn-secondary:hover {
		background: rgba(0, 113, 227, 0.08);
	}
	.trust-band {
		display: flex;
		gap: 1.6em;
		list-style: none;
		padding: 0;
		margin: 0;
		flex-wrap: wrap;
	}
	.trust-band li {
		font-size: 13px;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 5px;
	}
	.trust-check {
		color: var(--accent);
		font-weight: 700;
	}

	/* ─── Results ─── */
	.scan-result {
		padding: 1em 0 5em;
	}
	.score-panel {
		display: flex;
		gap: 3em;
		align-items: center;
		flex-wrap: wrap;
		background: #f5f5f7;
		border-radius: 20px;
		padding: 2.5em;
		margin-bottom: 1.4em;
	}
	.score-ring {
		width: 112px;
		height: 112px;
		border: 4px solid #d2d2d7;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5em;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: #fff;
	}
	.ring-good { border-color: #34c759; }
	.ring-mid { border-color: #ff9f0a; }
	.ring-bad { border-color: #ff3b30; }
	.score-caption {
		text-align: center;
		margin-top: 0.7em;
		font-size: 13px;
		color: var(--text-muted);
	}
	.score-tracks {
		flex: 1;
		min-width: 260px;
		display: flex;
		flex-direction: column;
		gap: 1.4em;
	}
	.track-head {
		display: flex;
		justify-content: space-between;
		font-size: 14px;
		margin-bottom: 7px;
	}
	.track-head span {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.bar {
		height: 8px;
		background: #e8e8ed;
		border-radius: 4px;
		overflow: hidden;
	}
	.bar-fill {
		height: 100%;
		width: 0;
		border-radius: 4px;
		transition: width 0.8s ease;
	}
	.bar-fill.cn { background: #ff3b30; }
	.bar-fill.gl { background: #0071e3; }
	.track-note {
		margin: 7px 0 0;
		font-size: 12px;
		color: var(--text-muted);
	}
	.result-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.4em;
		margin-bottom: 1.4em;
	}
	.card {
		background: #f5f5f7;
		border-radius: 20px;
		padding: 1.8em;
	}
	.card h3 {
		font-size: 1.02em;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 0 0 1em;
	}
	.card-note {
		font-size: 12px;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 1em 0 0;
	}
	.mini-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}
	.mini-table td {
		padding: 9px 4px;
		border-bottom: 1px solid #e8e8ed;
	}
	.mini-table tr:last-child td {
		border-bottom: none;
	}
	.td-status {
		white-space: nowrap;
		text-align: right;
		color: var(--text-secondary);
		font-size: 13px;
	}
	.crawler-name {
		display: block;
		font-size: 11px;
		color: var(--text-muted);
	}
	.check-list {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 14px;
		line-height: 2.1;
	}
	.dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		margin-right: 8px;
		vertical-align: middle;
	}
	.dot-good { background: #34c759; }
	.dot-ok { background: #a2d39b; }
	.dot-bad { background: #ff3b30; }
	.actions-card {
		margin-bottom: 1.4em;
	}
	.action-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1em;
	}
	.action-list li {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	.action-list p {
		margin: 4px 0 0;
		font-size: 13px;
		color: var(--text-secondary);
		line-height: 1.6;
	}
	.pri {
		flex-shrink: 0;
		font-size: 11px;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 980px;
		margin-top: 1px;
	}
	.pri-P0 { background: #ffe5e3; color: #d70015; }
	.pri-P1 { background: #ffefd6; color: #c93400; }
	.pri-P2 { background: #fff8dd; color: #8a6d00; }
	.pri-P3 { background: #e8e8ed; color: #515154; }
	.cta-block {
		background: #f5f5f7;
		border-radius: 20px;
		padding: 2.6em;
	}
	.cta-block h3 {
		margin: 0 0 0.6em;
		font-size: 1.35em;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	.cta-block p {
		color: var(--text-secondary);
		line-height: 1.7;
		max-width: 640px;
		margin-bottom: 1.5em;
	}
	.cta-row {
		display: flex;
		gap: 1.4em;
		align-items: center;
		flex-wrap: wrap;
	}
	.cta-alt {
		font-size: 14px;
		color: var(--text-muted);
	}

	@media (max-width: 720px) {
		.scan-hero h1 { font-size: 1.9em; }
		.score-panel { padding: 1.6em; gap: 1.6em; }
		.card { padding: 1.4em; }
	}
</style>
