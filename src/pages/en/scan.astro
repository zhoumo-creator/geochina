---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Free Chinese GEO Scan — Do Chinese AI engines recommend your site? | GEO China"
			description="Enter your website and get a 60-second dual-track AI readiness report: Chinese AI engines (Doubao/Kimi/Yuanbao/ERNIE/Qwen) + global AI engines — crawler reachability, SSR, structured data, citability score and a prioritized fix list."
		/>
	</head>
	<body>
		<Header lang="en" altHref="/scan" />

		<main>
			<section class="scan-hero">
				<div class="section-label"><span class="label-dot"></span> Free Tool</div>
				<h1>Do Chinese AI engines<br />recommend your site?</h1>
				<p class="lead">
					Doubao, Kimi, Yuanbao, ERNIE and Qwen are making recommendations<br />
					to your customers right now. Enter a URL — results in 60 seconds.
				</p>

				<div class="scan-box">
					<form id="scan-form" class="scan-form">
						<input id="scan-url" type="text" placeholder="Enter your website, e.g. example.com" autocomplete="url" required />
						<button type="submit" class="btn-scan" id="scan-btn">Scan</button>
					</form>
					<p class="scan-hint" id="scan-status"></p>
				</div>

				<ul class="trust-row">
					<li>Free</li>
					<li>No sign-up</li>
					<li>Results in 60s</li>
				</ul>
			</section>

			<section class="scan-result" id="result" hidden>
				<div class="score-section">
					<div class="score-ring" id="score-ring"><span id="score-overall">0</span></div>
					<p class="score-label">AI Engine Readiness<span class="score-verdict" id="score-verdict"></span></p>

					<div class="score-bars">
						<div class="score-bar-row">
							<span class="bar-label">Chinese</span>
							<div class="bar"><div class="bar-fill cn" id="bar-cn"></div></div>
							<span class="bar-val" id="score-cn">0</span>
						</div>
						<div class="score-bar-row">
							<span class="bar-label">Global</span>
							<div class="bar"><div class="bar-fill gl" id="bar-global"></div></div>
							<span class="bar-val" id="score-global">0</span>
						</div>
					</div>

					<button class="btn-dl" id="download-btn">Download report</button>
				</div>

				<div class="grid-2">
					<div class="card">
						<h3>Chinese engine crawlers</h3>
						<table class="tbl" id="table-cn"></table>
						<p class="note">For the Chinese market you must allow Bytespider — otherwise Doubao can't see you.</p>
					</div>
					<div class="card">
						<h3>Global engine crawlers</h3>
						<table class="tbl" id="table-global"></table>
					</div>
				</div>

				<div class="grid-2">
					<div class="card">
						<h3>Infrastructure</h3>
						<ul class="ck" id="check-list"></ul>
					</div>
					<div class="card">
						<h3>Citability</h3>
						<ul class="ck" id="trigger-list"></ul>
						<p class="note">AI answers love quoting tables, numbers and step lists — the higher the rating, the more likely to be cited.</p>
					</div>
				</div>

				<div class="card" id="actions-card" hidden>
					<h3>Priority fixes</h3>
					<ol class="act" id="action-list"></ol>
				</div>

				<div class="cta">
					<p class="cta-title">Want to know how Doubao and Kimi answer questions in your industry?</p>
					<p class="cta-body">The scan above is a site checkup. Real visibility — whether 5 major Chinese engines recommend you, who they cite — requires asking each engine real questions.</p>
					<div class="cta-row">
						<a class="btn-scan" href="mailto:hi@geochina.co">Email us</a>
						<span class="cta-alt">or WeChat: Moumlbius</span>
					</div>
				</div>
			</section>
		</main>

		<Footer lang="en" />

		<script>
			const form = document.getElementById('scan-form');
			const statusEl = document.getElementById('scan-status');
			const btn = document.getElementById('scan-btn');
			const result = document.getElementById('result');
			let lastData = null;

			const STEPS = ['Fetching your site…','Checking AI crawler rules…','Analyzing structured data…','Computing dual-track readiness…'];

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const url = document.getElementById('scan-url').value.trim();
				if (!url) return;
				btn.disabled = true; btn.textContent = 'Scanning…';
				result.hidden = true;
				let step = 0;
				statusEl.textContent = STEPS[0];
				const ticker = setInterval(() => { step = Math.min(step+1, STEPS.length-1); statusEl.textContent = STEPS[step]; }, 2500);
				try {
					const res = await fetch('/api/scan', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({url, lang:'en'}) });
					const data = await res.json();
					clearInterval(ticker);
					if (!data.ok) { statusEl.textContent = data.error || 'Scan failed'; return; }
					statusEl.textContent = data.cached ? 'Done (showing cached result from past 7 days)' : 'Scan complete';
					lastData = data; render(data);
				} catch { clearInterval(ticker); statusEl.textContent = 'Network error'; }
				finally { btn.disabled = false; btn.textContent = 'Scan'; }
			});

			document.getElementById('download-btn').addEventListener('click', () => {
				if (!lastData) return;
				const md = buildReport(lastData);
				const host = new URL(lastData.url).hostname.replace(/\./g,'-');
				const blob = new Blob([md], {type:'text/markdown;charset=utf-8'});
				const a = document.createElement('a');
				a.href = URL.createObjectURL(blob); a.download = `geo-report-${host}.md`; a.click(); URL.revokeObjectURL(a.href);
			});

			function sLabel(s) { return s==='blocked'?'Blocked':s==='allowed'?'Allowed':'Default allow'; }
			function sDot(s) { return `<span class="d ${s==='blocked'?'d-r':s==='allowed'?'d-g':'d-y'}"></span>${sLabel(s)}`; }
			function cDot(ok) { return `<span class="d ${ok?'d-g':'d-r'}"></span>`; }

			function buildReport(d) {
				const line = c => `| ${c.engine} | ${c.name} | ${sLabel(c.status)} |`;
				const ck = d.checks;
				const checks = [[ck.ssr,'Server-side rendering'],[ck.robotsTxt,'robots.txt'],[ck.sitemap,`sitemap${ck.sitemapUrls?` (${ck.sitemapUrls} URLs)`:''}`],[ck.llmsTxt,'llms.txt'],[ck.schemaTypes.length>0,`Structured data${ck.schemaTypes.length?': '+ck.schemaTypes.join(', '):''}`],[ck.hasUpdateTimestamp,'Update timestamp']];
				return `# AI Engine Readiness Report: ${new URL(d.url).hostname}\n\n> Scanned: ${d.scannedAt.slice(0,10)} | geochina.co/en/scan\n\n## Overall ${d.scores.overall}/100\n\n| Track | Score |\n|---|---|\n| Chinese engines | ${d.scores.china} |\n| Global engines | ${d.scores.global} |\n\n## Chinese crawlers\n\n| Engine | Crawler | Status |\n|---|---|---|\n${d.crawlers.cn.map(line).join('\n')}\n\n## Global crawlers\n\n| Engine | Crawler | Status |\n|---|---|---|\n${d.crawlers.global.map(line).join('\n')}\n\n## Infrastructure\n\n${checks.map(([ok,l])=>`- ${ok?'✅':'❌'} ${l}`).join('\n')}\n\n## Citability\n\n${ck.triggers.map(t=>`- ${t.found?'✅':'❌'} ${t.label}`).join('\n')}\n\n## Priority fixes\n\n${d.actions.map((a,i)=>`${i+1}. **[${a.priority}] ${a.title}**\n   ${a.why}`).join('\n\n')}\n\n---\nWeChat Moumlbius | hi@geochina.co | geochina.co\n`;
			}

			function render(d) {
				const o = d.scores.overall;
				document.getElementById('score-overall').textContent = o;
				document.getElementById('score-cn').textContent = d.scores.china;
				document.getElementById('score-global').textContent = d.scores.global;
				document.getElementById('bar-cn').style.width = d.scores.china+'%';
				document.getElementById('bar-global').style.width = d.scores.global+'%';
				const ring = document.getElementById('score-ring');
				ring.className = 'score-ring '+(o>=70?'r-g':o>=45?'r-y':'r-r');
				const v = document.getElementById('score-verdict');
				v.textContent = o>=70?' · Good':o>=45?' · Fair':' · Needs work';

				const row = c => `<tr><td>${c.engine}<span class="sub">${c.name}</span></td><td class="r">${sDot(c.status)}</td></tr>`;
				document.getElementById('table-cn').innerHTML = d.crawlers.cn.map(row).join('');
				document.getElementById('table-global').innerHTML = d.crawlers.global.map(row).join('');

				const ck = d.checks;
				const checks = [[ck.ssr,'Server-side rendering'],[ck.robotsTxt,'robots.txt'],[ck.sitemap,`sitemap${ck.sitemapUrls?` (${ck.sitemapUrls} URLs)`:''}`],[ck.llmsTxt,'llms.txt'],[ck.schemaTypes.length>0,`Structured data${ck.schemaTypes.length?': '+ck.schemaTypes.slice(0,3).join(', '):''}`],[ck.hasUpdateTimestamp,'Update timestamp']];
				document.getElementById('check-list').innerHTML = checks.map(([ok,l])=>`<li>${cDot(ok)}${l}</li>`).join('');
				document.getElementById('trigger-list').innerHTML = ck.triggers.map(t=>`<li>${cDot(t.found)}<span class="stars">${'●'.repeat(t.stars)}${'○'.repeat(5-t.stars)}</span>${t.label}</li>`).join('');

				const ac = document.getElementById('actions-card');
				if (d.actions && d.actions.length) {
					ac.hidden = false;
					document.getElementById('action-list').innerHTML = d.actions.map(a=>`<li><span class="pri p-${a.priority}">${a.priority}</span><div><strong>${a.title}</strong><p>${a.why}</p></div></li>`).join('');
				} else { ac.hidden = true; }

				result.hidden = false;
				result.scrollIntoView({behavior:'smooth',block:'start'});
			}
		</script>
	</body>
</html>

<style>
	main { width: 920px; }

	/* ─── Hero ─── */
	.scan-hero { max-width: 600px; padding: 5em 0 3em; }
	.section-label {
		display: flex; align-items: center; gap: 6px;
		font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
		text-transform: uppercase; color: var(--text-muted); margin-bottom: 1.6em;
	}
	.label-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
	.scan-hero h1 {
		font-family: var(--font-serif);
		font-size: 2.4em; line-height: 1.2; font-weight: 700;
		letter-spacing: -0.02em; margin-bottom: 0.6em;
	}
	.lead { font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2em; }
	.scan-box { margin-bottom: 1.4em; }
	.scan-form { display: flex; gap: 8px; }
	.scan-form input {
		flex: 1; padding: 12px 16px; font-size: 15px;
		border: 1px solid var(--border); border-radius: 10px;
		background: #fff; color: var(--text); outline: none;
	}
	.scan-form input:focus { border-color: #0071e3; box-shadow: 0 0 0 3px rgba(0,113,227,0.12); }
	.scan-hint { margin: 0.7em 0 0; font-size: 13px; color: var(--text-muted); min-height: 1.2em; }
	.btn-scan {
		padding: 12px 24px; background: #0071e3; color: #fff; border: none;
		border-radius: 10px; font-weight: 500; font-size: 15px;
		cursor: pointer; white-space: nowrap; text-decoration: none;
		display: inline-flex; align-items: center; justify-content: center;
	}
	.btn-scan:hover { background: #0077ed; color: #fff; }
	.btn-scan:disabled { opacity: 0.5; cursor: wait; }
	.trust-row {
		display: flex; gap: 1.4em; list-style: none; padding: 0; margin: 0;
		font-size: 12px; color: var(--text-muted);
	}
	.trust-row li::before { content: '✓ '; color: var(--accent); font-weight: 600; }

	/* ─── Results ─── */
	.scan-result { padding: 0 0 5em; }

	/* Score */
	.score-section { text-align: center; padding: 2em 0 2.4em; }
	.score-ring {
		width: 96px; height: 96px; margin: 0 auto 0.6em;
		border: 3px solid #d2d2d7; border-radius: 50%;
		display: flex; align-items: center; justify-content: center;
		font-size: 2.2em; font-weight: 700; letter-spacing: -0.02em;
		font-family: var(--font-sans); background: #fff;
	}
	.r-g { border-color: #34c759; color: #1a7f37; }
	.r-y { border-color: #ff9f0a; color: #9a6700; }
	.r-r { border-color: #ff3b30; color: #d1242f; }
	.score-label { font-size: 13px; color: var(--text-muted); margin-bottom: 1.6em; }
	.score-verdict { font-weight: 600; }

	.score-bars { max-width: 400px; margin: 0 auto 1.6em; }
	.score-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
	.bar-label { font-size: 13px; color: var(--text-secondary); width: 64px; text-align: right; flex-shrink: 0; }
	.bar { flex: 1; height: 5px; background: #e8e8ed; border-radius: 3px; overflow: hidden; }
	.bar-fill { height: 100%; width: 0; border-radius: 3px; transition: width 0.8s ease; }
	.bar-fill.cn { background: #ff3b30; }
	.bar-fill.gl { background: #0071e3; }
	.bar-val { font-size: 13px; font-weight: 600; width: 28px; text-align: left; font-variant-numeric: tabular-nums; color: var(--text); }

	.btn-dl {
		padding: 8px 20px; font-size: 13px; font-weight: 500;
		background: none; border: 1px solid var(--border); border-radius: 980px;
		color: var(--text-secondary); cursor: pointer;
	}
	.btn-dl:hover { border-color: var(--text-muted); color: var(--text); }

	/* Cards */
	.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
	.card { background: #f5f5f7; border-radius: 16px; padding: 1.4em 1.6em; }
	.card h3 { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: var(--text); margin: 0 0 0.8em; letter-spacing: 0; }
	.note { font-size: 12px; color: var(--text-muted); line-height: 1.5; margin: 0.8em 0 0; }

	/* Tables (JS-injected, needs :global) */
	.tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
	.tbl :global(td) { padding: 6px 0; border-bottom: 1px solid rgba(0,0,0,0.06); color: var(--text); }
	.tbl :global(tr:last-child td) { border-bottom: none; }
	.tbl :global(.r) { text-align: right; font-size: 13px; color: var(--text-secondary); white-space: nowrap; }
	.tbl :global(.sub) { display: block; font-size: 11px; color: var(--text-muted); margin-top: 1px; }

	/* Dots (JS-injected) */
	:global(.d) { display: inline-block; width: 6px; height: 6px; min-width: 6px; border-radius: 50%; margin-right: 6px; vertical-align: middle; flex-shrink: 0; }
	:global(.d-g) { background: #34c759; }
	:global(.d-y) { background: #a2d39b; }
	:global(.d-r) { background: #ff3b30; }

	/* Check lists (JS-injected) */
	.ck { list-style: none; padding: 0; margin: 0; font-size: 14px; }
	.ck :global(li) { padding: 5px 0; border-bottom: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 2px; color: var(--text); }
	.ck :global(li:last-child) { border-bottom: none; }
	:global(.stars) { font-size: 9px; color: #d2d2d7; margin-right: 6px; letter-spacing: 0.5px; }
	.ck :global(.d-g ~ .stars) { color: #ff9f0a; }

	/* Actions (JS-injected) */
	#actions-card { margin-bottom: 12px; }
	.act { list-style: none; padding: 0; margin: 0; }
	.act :global(li) { display: flex; gap: 8px; align-items: flex-start; padding: 6px 0; border-bottom: 1px solid rgba(0,0,0,0.05); }
	.act :global(li:last-child) { border-bottom: none; }
	.act :global(strong) { font-size: 14px; font-weight: 600; }
	.act :global(p) { margin: 2px 0 0; font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
	:global(.pri) { flex-shrink: 0; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 4px; margin-top: 2px; }
	:global(.p-P0) { background: #fee; color: #c00; }
	:global(.p-P1) { background: #fff3e0; color: #b45300; }
	:global(.p-P2) { background: #fff9db; color: #8a6d00; }
	:global(.p-P3) { background: #f0f0f0; color: #666; }

	/* CTA */
	.cta { background: #1d1d1f; border-radius: 16px; padding: 2em 2em; margin-top: 12px; }
	.cta-title { font-family: var(--font-serif); font-size: 1.2em; font-weight: 600; color: #fff; margin: 0 0 0.5em; line-height: 1.3; }
	.cta-body { font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.6; margin: 0 0 1.2em; max-width: 540px; }
	.cta-row { display: flex; gap: 1em; align-items: center; flex-wrap: wrap; }
	.cta .btn-scan { background: #0071e3; font-size: 14px; padding: 10px 22px; border-radius: 8px; }
	.cta-alt { font-size: 13px; color: rgba(255,255,255,0.4); }

	@media (max-width: 720px) {
		.scan-hero h1 { font-size: 1.8em; }
		.grid-2 { grid-template-columns: 1fr; }
		.card { padding: 1.2em; }
	}
</style>
