---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import DitherIsland from '../../components/DitherIsland.jsx';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter(post => post.id.endsWith('-en'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="GEO China — AI-Driven Growth Agent for Chinese-speaking B2B teams"
			description="GEO Agent that ships merge-ready PRs across 9 AI engines (Doubao, Kimi, Yuanbao, Wenxin, Tongyi + ChatGPT, Perplexity, Claude, Google AIO). Plus a vetted provider network for cross-platform integrated marketing across Reddit, X, Xiaohongshu, and more."
		/>
	</head>
	<body>
		<Header lang="en" />

		<!-- Hero: Large Typography + Dither Canvas -->
		<section class="hero">
			<div class="hero-text">
				<div class="section-label hero-label"><span class="label-dot"></span> AI-DRIVEN GROWTH AGENT</div>
				<h1>
					You set direction.<br/>Agents ship the work.
				</h1>
				<p class="hero-subhead">
					A GEO Agent for Chinese-speaking B2B teams. Coverage across 9 AI engines, merge-ready PRs every week — you click Merge, rankings move.
				</p>
				<div class="hero-ctas">
					<a href="/en/scan" class="btn-cta">
						Free AI Visibility Scan
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
					</a>
					<a href="/en/skills" class="btn-outline-dark">
						Browse Open-Source Skills
					</a>
				</div>
			</div>
			<div class="hero-canvas">
				<DitherIsland client:load />
			</div>
		</section>

		<!-- Engines Strip -->
		<section class="engines-strip">
			<div class="engines-inner">
				<p class="engines-title">9 AI engines covered</p>
				<div class="engines-track">
					<span class="engine-tag cn">豆包 Doubao</span>
					<span class="engine-tag cn">Kimi</span>
					<span class="engine-tag cn">元宝 Yuanbao</span>
					<span class="engine-tag cn">文心 Wenxin</span>
					<span class="engine-tag cn">通义 Tongyi</span>
					<span class="engines-divider"></span>
					<span class="engine-tag west">ChatGPT</span>
					<span class="engine-tag west">Perplexity</span>
					<span class="engine-tag west">Claude</span>
					<span class="engine-tag west">Google AIO</span>
				</div>
			</div>
		</section>

		<!-- Stats Strip -->
		<section class="stats-strip">
			<div class="stats-inner">
				<div class="stat-item">
					<span class="stat-value">33 <small>×</small></span>
					<span class="stat-desc">Rootly's AI citation growth after implementing GEO strategies</span>
					<span class="stat-src">Source: Rootly 2025 public case study</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">78.72 <small>%</small></span>
					<span class="stat-desc">Probability of being cited in AI summaries with structured GEO</span>
					<span class="stat-src">Source: Princeton KDD 2024 paper</span>
				</div>
				<div class="stat-item">
					<span class="stat-value">100 <small>M</small></span>
					<span class="stat-desc">Weekly users getting answers via AI search engines in China</span>
					<span class="stat-src">Source: QuestMobile 2025 estimate</span>
				</div>
			</div>
		</section>

		<!-- Mission -->
		<section class="mission-section">
			<p class="mission-text">Our goal: build the most useful GEO Agent in the industry.</p>
		</section>

		<main>
			<!-- Product pillars -->
			<section class="pillars-section">
				<div class="section-label"><span class="label-dot"></span> Three Entry Points, One Path</div>
				<h2 class="pillars-title">Try it, adopt it, then hand it to us</h2>
				<div class="pillars-grid">
					<a href="/en/scan" class="pillar-card">
						<span class="pillar-num">01 · Free Tool</span>
						<h3>Online GEO Scan</h3>
						<p>Enter a URL and get a 60-second dual-track readiness report — Chinese + global AI engines: crawler reachability, SSR, structured data, citability, with a prioritized fix list.</p>
						<span class="pillar-link">Scan for free →</span>
					</a>
					<a href="/en/skills" class="pillar-card">
						<span class="pillar-num">02 · Open-Source Skills</span>
						<h3>Curated + Original GEO Skills</h3>
						<p>We deep-read and tore down the open-source GEO skills out there, keeping only what ships results — and we're filling the confirmed blank ourselves: Chinese 5-engine monitoring, open-sourced as we go.</p>
						<span class="pillar-link">Browse skills →</span>
					</a>
					<a href="/en/services" class="pillar-card">
						<span class="pillar-num">03 · Subscription</span>
						<h3>A GEO Agent That Delivers Weekly</h3>
						<p>Don't want to DIY? Subscribe and receive every week: a 5-engine Chinese visibility dashboard, competitor moves, publish-ready content and merge-ready fixes — you just click Merge.</p>
						<span class="pillar-link">See services →</span>
					</a>
				</div>
			</section>

			<!-- What is GEO -->
			<section class="what-section">
				<div class="what-grid">
					<div class="what-left">
						<div class="section-label"><span class="label-dot"></span> Concept</div>
						<h2>SEO optimizes ranking.<br/>GEO optimizes citation.</h2>
					</div>
					<div class="what-right">
						<p>
							Traditional SEO aims to put you on Google's first page. GEO aims to make AI answer engines — ChatGPT, Perplexity, Doubao, Kimi, Google AI Overview — actively cite your content as a source.
						</p>
						<p>
							Per Princeton research, structured GEO can lift content visibility in AI-generated answers by up to <strong>40%</strong>. AI-referred traffic typically converts at <strong>5×</strong> the rate of traditional search.
						</p>
					</div>
				</div>
			</section>

			<!-- Comparison Table -->
			<section class="compare-section">
				<div class="section-label"><span class="label-dot"></span> Compare</div>
				<h2>GeoChina Agent vs Traditional SEO Tools</h2>
				<p class="compare-lead">Traditional tools stop at "telling you what to fix." GEO Agent ships the fix.</p>
				<div class="compare-wrap">
					<table class="compare-table">
						<thead>
							<tr>
								<th></th>
								<th class="col-us">GeoChina Agent</th>
								<th>Ahrefs / SEMrush</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Deliverable</td>
								<td class="col-us">Merge-ready PRs (code-level)</td>
								<td>PDF / dashboard reports</td>
							</tr>
							<tr>
								<td>Execution</td>
								<td class="col-us">Agent auto-executes</td>
								<td>5+ manual steps required</td>
							</tr>
							<tr>
								<td>Chinese AI engines</td>
								<td class="col-us">5 engines covered</td>
								<td>Not supported</td>
							</tr>
							<tr>
								<td>Optimization target</td>
								<td class="col-us">AI citation rate (GEO)</td>
								<td>Search ranking (SEO)</td>
							</tr>
							<tr>
								<td>Code ownership</td>
								<td class="col-us">100% yours</td>
								<td>N/A</td>
							</tr>
							<tr>
								<td>Model</td>
								<td class="col-us">Questionnaire + Agent-as-a-Service</td>
								<td>Self-serve SaaS subscription</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- Blog -->
			<section class="blog-section">
				<h2>Latest Articles</h2>
				<div class="posts-list">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-row">
							<div class="post-info">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
								</time>
								<h3>{post.data.title}</h3>
							</div>
							<span class="post-arrow">→</span>
						</a>
					))}
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-section">
				<h2>Start with a free scan</h2>
				<p>Mix and match Agent + Services. We listen first, then quote — and we'll tell you if we're not the fit.</p>
				<div class="cta-buttons">
					<a href="/en/scan" class="btn-cta">
						Free AI Visibility Scan
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
					</a>
					<a href="mailto:hi@geochina.co" class="btn-outline-dark">Email Us Directly</a>
				</div>
			</section>

		</main>
		<Footer lang="en" />
	</body>
</html>

<style>
	main {
		width: var(--max-w-wide);
		max-width: calc(100% - 3em);
	}

	/* HERO */
	.hero {
		max-width: var(--max-w-wide);
		margin: 0 auto;
		padding: 6em 1.5em 2em;
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 4em;
		align-items: center;
	}
	.hero h1 {
		font-size: 4.4em;
		line-height: 1.08;
		letter-spacing: -0.035em;
		margin-bottom: 0.5em;
	}
	.hero-label { margin-bottom: 1.5em; }
	.hero-subhead {
		font-size: 1.1em;
		color: var(--text-secondary);
		margin-top: 0;
		margin-bottom: 1.8em;
		line-height: 1.7;
		max-width: 520px;
	}
	.hero-ctas {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 1.6em;
	}
	.hero-canvas {
		width: 100%;
		height: 480px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: #f0f0ec;
	}

	/* Engines strip */
	.engines-strip {
		background: var(--accent-deep);
		padding: 1.4em 0;
		overflow: hidden;
	}
	.engines-inner {
		max-width: var(--max-w-wide);
		margin: 0 auto;
		padding: 0 1.5em;
		display: flex;
		align-items: center;
		gap: 2.5em;
	}
	.engines-title {
		font-size: 11px;
		color: rgba(255,255,255,0.55);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
		margin: 0;
	}
	.engines-track {
		display: flex;
		align-items: center;
		gap: 1.8em;
		flex: 1;
		flex-wrap: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.engines-track::-webkit-scrollbar { display: none; }
	.engine-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 14px;
		font-weight: 500;
		white-space: nowrap;
	}
	.engine-tag.cn { color: var(--gold); }
	.engine-tag.west { color: rgba(255,255,255,0.85); }
	.engines-divider {
		height: 16px;
		width: 1px;
		background: rgba(255,255,255,0.25);
		flex-shrink: 0;
	}

	/* Stats */
	.stats-strip { max-width: var(--max-w-wide); margin: 0 auto; padding: 4em 1.5em 3em; border-bottom: 1px solid var(--border); position: relative; }
	.stats-inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3em; }
	.stat-value { display: block; font-family: var(--font-serif); font-size: 3.5em; font-weight: 400; color: var(--black); letter-spacing: -0.02em; line-height: 1; margin-bottom: 16px; }
	.stat-value small { font-size: 0.5em; color: var(--text-muted); font-weight: 400; }
	.stat-desc { display: block; font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
	.stat-src { display: block; font-size: 11px; color: var(--text-muted); margin-top: 4px; }

	/* Mission */
	.mission-section { max-width: var(--max-w-wide); margin: 0 auto; padding: 3em 1.5em; border-bottom: 1px solid var(--border); text-align: center; }
	.mission-text { font-family: var(--font-serif); font-size: 1.4em; color: var(--text-secondary); font-weight: 400; margin: 0; letter-spacing: -0.01em; }

	/* Pillars */
	.pillars-section { padding: 4em 0 3em; border-bottom: 1px solid var(--border); }
	.pillars-title { font-size: 2em; margin: 0.5em 0 1.2em; }
	.pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4em; }
	.pillar-card { display: flex; flex-direction: column; background: var(--bg-section); border-radius: var(--radius-lg); padding: 1.8em; text-decoration: none; color: var(--text); transition: transform 0.2s, box-shadow 0.2s; }
	.pillar-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07); }
	.pillar-num { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1em; }
	.pillar-card h3 { font-family: var(--font-sans); font-size: 1.15em; font-weight: 700; margin-bottom: 0.6em; }
	.pillar-card p { font-size: 14px; color: var(--text-secondary); line-height: 1.75; flex: 1; margin-bottom: 1.2em; }
	.pillar-link { font-size: 14px; font-weight: 600; color: var(--accent); }

	/* What */
	.what-section { padding: 4em 0; border-bottom: 1px solid var(--border); }
	.what-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4em; }
	.what-left h2 { font-size: 2.4em; margin-top: 0.5em; }
	.what-right p { font-size: 16px; color: var(--text-secondary); line-height: 1.85; }
	.what-right strong { color: var(--black); }

	/* Blog */
	.blog-section { padding: 4em 0 2em; }
	.blog-section h2 { margin-bottom: 1em; }
	.post-row { display: flex; align-items: center; justify-content: space-between; padding: 1.5em 0; border-top: 1px solid var(--border-light); text-decoration: none; transition: padding-left 0.2s; }
	.post-row:last-child { border-bottom: 1px solid var(--border-light); }
	.post-row:hover { padding-left: 12px; }
	.post-info time { font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 4px; }
	.post-info h3 { font-family: var(--font-sans); font-size: 1.05em; font-weight: 700; color: var(--black); transition: color 0.15s; }
	.post-row:hover h3 { color: var(--accent); }
	.post-arrow { font-size: 1.3em; color: var(--text-muted); transition: transform 0.15s; }
	.post-row:hover .post-arrow { transform: translateX(4px); color: var(--black); }

	/* CTA */
	.cta-section { text-align: center; padding: 5em 2em; margin: 3em 0; background: var(--bg-section); border-radius: var(--radius-lg); }
	.cta-section h2 { margin-bottom: 0.4em; font-size: 2.2em; }
	.cta-section p { margin-bottom: 1.8em; font-size: 1.05em; }
	.cta-buttons { display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; }

	/* Compare */
	.compare-section { padding: 4em 0; border-bottom: 1px solid var(--border); }
	.compare-section h2 { margin-top: 0.5em; margin-bottom: 0.3em; font-size: 2em; }
	.compare-lead { font-size: 15px; color: var(--text-secondary); margin-bottom: 2em; }
	.compare-wrap { overflow-x: auto; }
	.compare-table { width: 100%; border-collapse: collapse; font-size: 15px; }
	.compare-table th, .compare-table td { padding: 1em 1.2em; text-align: left; border-bottom: 1px solid var(--border-light); }
	.compare-table thead th { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); border-bottom: 2px solid var(--border); }
	.compare-table thead th.col-us { color: var(--accent); }
	.compare-table td:first-child { font-weight: 600; color: var(--text-secondary); min-width: 110px; }
	.compare-table td.col-us { color: var(--accent); font-weight: 600; }
	.compare-table tbody tr:hover { background: var(--bg-soft); }
	@media (max-width: 720px) {
		.hero { grid-template-columns: 1fr; padding-top: 2.5em; }
		.hero h1 { font-size: 2.4em; }
		.hero-canvas { height: 280px; }
		.hero-ctas { flex-direction: column; align-items: stretch; }
		.btn-cta, .btn-outline-dark { justify-content: center; }
		.engines-inner { flex-direction: column; align-items: flex-start; gap: 0.9em; }
		.stats-inner { grid-template-columns: 1fr; gap: 2em; }
		.stat-value { font-size: 2em; }
		.what-grid { grid-template-columns: 1fr; gap: 1.5em; }
		.pillars-grid { grid-template-columns: 1fr; }
	}
</style>
