---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Services — GEO China"
			description="Three offerings: SEO/GEO Agent · Cross-platform Integrated Marketing · Custom Audit & Consulting. AI growth partner for Chinese-speaking B2B teams."
		/>
	</head>
	<body>
		<Header lang="en" />
		<main>
			<section class="page-header">
				<div class="section-label"><span class="label-dot"></span> Services</div>
				<h1>Three lines, one team.</h1>
				<p class="page-desc">
					One product line where the Agent auto-ships PRs. One service line where a vetted provider network runs integrated marketing. And one-shot consulting on demand.
				</p>
			</section>

			<section class="services-row">
				<div class="svc-card">
					<span class="svc-tag tag-cta">Product · SaaS</span>
					<h2>SEO / GEO Agent</h2>
					<p class="svc-desc">
						Coverage across 9 AI engines, merge-ready PRs every week. Code stays with you, 30-day refund, cancel anytime.
					</p>
					<p class="svc-meta">$99 / $999 monthly · EN + ZH</p>
				</div>

				<div class="svc-card">
					<span class="svc-tag tag-gold">Service · Provider Network</span>
					<h2>Integrated Marketing</h2>
					<p class="svc-desc">
						We do strategy and orchestration. A vetted provider network executes across Reddit / X / Xiaohongshu / Zhihu / B站 / 公众号 + offline hacker houses.
					</p>
					<p class="svc-meta">From $2.5k / month</p>
				</div>

				<div class="svc-card">
					<span class="svc-tag tag-blue">Consulting · One-shot</span>
					<h2>Audit & Consulting</h2>
					<p class="svc-desc">
						GEO technical audit, 5-layer competitor reverse engineering, going-global / China-entry strategy roadmap. For deep one-time deliverables.
					</p>
					<p class="svc-meta">From $400</p>
				</div>
			</section>

			<!-- Contact -->
			<section class="contact-section">
				<div class="section-label"><span class="label-dot"></span> Contact</div>
				<h2 class="contact-title">Tell us what you're building</h2>
				<p class="contact-lead">We listen first, quote second — and we'll tell you if we're not the fit. Copy the template below, send via your preferred channel, reply within 2 business days.</p>

				<div class="contact-card">
					<div class="template-head">
						<span class="template-label">📋 Inquiry template</span>
						<button class="copy-btn" type="button" onclick="navigator.clipboard.writeText(document.getElementById('email-template').innerText); this.textContent='Copied ✓'; setTimeout(()=>this.textContent='Copy',2000);">Copy</button>
					</div>
					<div id="email-template" class="template-body">I'm interested in (check all that apply):
☐ SEO/GEO Agent (product)
☐ Integrated marketing (provider service)
☐ Audit & consulting

Company / Website:
Top problem right now:
Outcome you want in 3 months:
Budget range:
Contact:</div>
				</div>

				<div class="contact-methods">
					<a href="https://t.me/zhoumo_828" target="_blank" rel="noopener" class="cm-card">
						<span class="cm-icon">✈</span>
						<span class="cm-label">Telegram</span>
						<span class="cm-value">@zhoumo_828</span>
					</a>
					<a href="mailto:hi@geochina.co" class="cm-card">
						<span class="cm-icon">✉</span>
						<span class="cm-label">Email</span>
						<span class="cm-value">hi@geochina.co</span>
					</a>
					<div class="cm-card">
						<span class="cm-icon">💬</span>
						<span class="cm-label">WeChat</span>
						<span class="cm-value">Moumlbius</span>
					</div>
				</div>

				<p class="contact-foot">
					Not sure yet? Start with a <a href="/scan">free 9-engine AI visibility scan →</a>
				</p>
			</section>

			<p class="page-updated">Last updated: May 2026</p>
		</main>
		<Footer lang="en" />
	</body>
</html>

<style>
	main { width: var(--max-w-wide); max-width: calc(100% - 3em); }
	.page-header { padding: 5em 0 3em; }
	.page-header h1 { margin-top: 0.6em; margin-bottom: 0.5em; font-size: 3.6em; line-height: 1.12; }
	.page-desc { font-size: 1.15em; color: var(--text-secondary); max-width: 680px; line-height: 1.7; }

	.services-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5em; padding: 2em 0 4em; }
	.svc-card { padding: 2.2em 1.8em; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); transition: all 0.2s; }
	.svc-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26, 122, 76, 0.08); }
	.svc-tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.2em; }
	.svc-tag.tag-cta { background: rgba(217, 75, 59, 0.12); color: var(--cta-hover); }
	.svc-tag.tag-gold { background: rgba(232, 168, 56, 0.18); color: #8a5a0a; }
	.svc-tag.tag-blue { background: #eff6ff; color: var(--blue); }
	.svc-card h2 { font-size: 1.5em; margin-bottom: 0.6em; }
	.svc-desc { font-size: 15px; line-height: 1.75; color: var(--text-secondary); margin-bottom: 1.2em; }
	.svc-meta { font-size: 13px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; margin: 0; }

	.contact-section { padding: 4em 0 5em; border-top: 1px solid var(--border); }
	.contact-title { margin-top: 0.6em; margin-bottom: 0.5em; font-size: 2.4em; }
	.contact-lead { font-size: 1.05em; line-height: 1.75; max-width: 680px; margin-bottom: 2em; }

	.contact-card { background: var(--bg-section); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 1.5em; }
	.template-head { display: flex; justify-content: space-between; align-items: center; padding: 0.9em 1.4em; border-bottom: 1px solid var(--border); background: var(--bg); }
	.template-label { font-size: 13px; font-weight: 700; color: var(--black); }
	.copy-btn { font-size: 12px; font-weight: 600; padding: 7px 14px; background: var(--accent); color: white; border: none; border-radius: 6px; cursor: pointer; font-family: inherit; transition: background 0.2s; }
	.copy-btn:hover { background: var(--accent-hover); }
	.template-body { font-family: 'JetBrains Mono', monospace; font-size: 14px; line-height: 2; color: var(--text); padding: 1.5em 1.6em; white-space: pre-wrap; word-break: break-word; }

	.contact-methods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9em; margin-bottom: 1.6em; }
	.cm-card { display: flex; flex-direction: column; gap: 0.3em; padding: 1.2em 1.3em; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); text-decoration: none; color: var(--text); transition: all 0.2s; }
	a.cm-card:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(26, 122, 76, 0.08); }
	.cm-icon { font-size: 18px; color: var(--accent); margin-bottom: 0.2em; }
	.cm-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); font-weight: 700; }
	.cm-value { font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 500; color: var(--black); }

	.contact-foot { font-size: 14px; color: var(--text-muted); margin: 0; }
	.contact-foot a { color: var(--accent); font-weight: 600; }

	.page-updated { text-align: center; font-size: 12px; color: var(--text-muted); padding: 2em 0 0; margin: 0; }

	@media (max-width: 960px) {
		.services-row { grid-template-columns: 1fr; }
		.contact-methods { grid-template-columns: 1fr; }
	}
	@media (max-width: 720px) {
		.page-header h1 { font-size: 2.2em; }
		.contact-title { font-size: 1.8em; }
	}
</style>
